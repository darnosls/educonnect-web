<p><%= link_to "Voltar", alunos_path %></p>


<section class="product">
    <%= image_tag @aluno.featured_image if @aluno.featured_image.attached? %>

    <section class="product-info">

        <% cache @aluno do %>

            <h1><%= @aluno.nome_usuario %></h1>
            <%= @aluno.biography %>
        <% end %>



        <% if authenticated? %>
            <%= link_to "Editar", edit_aluno_path(@aluno) %>
            <%= button_to "Excluir", @aluno, method: :delete, data: { turbo_confirm: "Você está certo disso?" } %>
        <% end %>
    </section>
</section>