<%= form_with model: aluno do |form| %>
  <div>
    <%= form.label :nome_usuario %>
    <%= form.text_field :nome_usuario %>
  </div>
    <div>
    <%= form.label :biography, style: "display: block" %>
    <%= form.rich_text_area :biography %>
  </div>
    <div>
    <%= form.label :featured_image, style: "display: block" %>
    <%= form.file_field :featured_image, accept: "image/*" %>
  </div>



  <div>
    <%= form.submit %>
  </div>
<% end %>
