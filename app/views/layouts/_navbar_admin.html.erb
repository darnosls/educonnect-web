<nav style="background-color: #333; padding: 0;">
    <div class="navbar-brand" >
          <%= image_tag("logo-final-BRANCA.png", :alt => "EduConenct", :class => "navbar-brand-logo") %>
        </div>
    <ul style="list-style: none; margin: 0; padding: 0; display: flex;">
        <li style="margin: 0;">
            <%= link_to 'Dashboard', dashboards_path, class: ("navbar-link#{' active' if current_page?(dashboards_path)}") %>
        </li>
        <li style="margin: 0;">
            <%= link_to 'Usuários', users_path, class: ("navbar-link#{' active' if current_page?(users_path)}") %>
        </li>
        <li style="margin: 0;">
            <%= link_to 'Cursos', courses_path, class: ("navbar-link#{' active' if current_page?(courses_path)}") %>
        </li>
        <li style="margin: 0;">
            <%= link_to 'Disciplinas', disciplines_path, class: ("navbar-link#{' active' if current_page?(disciplines_path)}") %>
        </li>
        <li style="margin: 0;">
            <%= link_to 'Conteúdos', contents_path, class: ("navbar-link#{' active' if current_page?(contents_path)}") %>
        </li>
        <li style="margin: 0;">
            <%= link_to 'Comentários', comments_path, class: ("navbar-link#{' active' if current_page?(comments_path)}") %>
        </li>
        <li style="margin: 0;">
        <%= button_to "Sair", session_path, method: :delete if authenticated? %>
        </li>
    </ul>
</nav>

<style>
    .navbar-link {
        display: block;
        color: #fff;
        text-decoration: none;
        padding: 16px 20px;
        transition: background 0.2s;
    }
    .navbar-link:hover {
        background: #444;
    }
    .navbar-link.active {
        background: #004080;
    }

    li {
        margin: 0;
    }
</style>